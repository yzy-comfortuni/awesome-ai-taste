---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../ui/breadcrumbs.astro";
import DesignSystemDirectory from "../../ui/design-system-directory";
import RelatedDirectoryLinks from "../../ui/related-directory-links.astro";
import { designSystemDirectoryLinks } from "../../data/directory-links";
import {
  designSystemCollections,
  designSystems,
} from "../../data/design-systems";

export function getStaticPaths() {
  return designSystemCollections.map((collection) => ({
    params: { collection: collection.routeSlug },
    props: { collection },
  }));
}

const { collection } = Astro.props as {
  collection: (typeof designSystemCollections)[number];
};
const collectionSystems = designSystems.filter(
  (system) => system.collection === collection.slug,
);
const breadcrumbItems = [
  { label: "Explore", href: "/" },
  { label: "Design systems", href: "/design-systems" },
  { label: collection.title },
];
const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const pageUrl = new URL(
  `/design-systems/${collection.routeSlug}`,
  siteOrigin,
).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: collection.seoTitle,
    description: collection.metaDescription,
    url: pageUrl,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: collectionSystems.length,
      itemListElement: collectionSystems.map((system, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: system.name,
        url: system.websiteUrl,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: new URL(
        item.href ?? `/design-systems/${collection.routeSlug}`,
        siteOrigin,
      ).toString(),
    })),
  },
];
---

<Layout
  structuredData={structuredData}
  title={`${collection.seoTitle} | UI Skills`}
  description={collection.metaDescription}
>
  <div class="relative flex min-h-dvh flex-col items-center justify-start">
    <div class="container-3xl relative mt-20">
      <div class="mx-auto flex w-full flex-col gap-10">
        <Breadcrumbs items={breadcrumbItems} />

        <div class="flex flex-col gap-3">
          <h1 class="type-h1 text-content-primary">{collection.title}</h1>
          <p class="type-body-md text-content-secondary">{collection.intro}</p>
        </div>

        <DesignSystemDirectory
          systems={collectionSystems}
          showCollectionHeaders={false}
          client:idle
        />

        <RelatedDirectoryLinks
          links={collection.relatedLinks ?? designSystemDirectoryLinks}
        />
      </div>
    </div>
  </div>
</Layout>

---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import PlaybookCard from "../../ui/playbook-card.astro";
import { playbook } from "../../data/playbook.ts";
import { skills } from "../../data/skills.ts";


const playbookCards = playbook
  .map((entry) => {
    const sourceSkill = skills.find((skill) => skill.slug === entry.skill);

    return sourceSkill ? entry : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const pageUrl = new URL("/playbook", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Learn",
  description:
    "Interactive playground and lessons from the best design engineering skills",
  url: pageUrl,
  hasPart: {
    "@type": "ItemList",
    itemListElement: playbook.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/playbook/${entry.slug}`, siteOrigin).toString(),
      name: entry.title,
    })),
  },
};
---

<Layout
  structuredData={structuredData}
  title="Learn | UI Skills"
  description="Interactive playground and lessons from the best design engineering skills"
>
  <div class="relative flex min-h-dvh flex-col items-center">
    <div class="relative mt-20 container-3xl">
      <div class="mx-auto flex w-full flex-col gap-8">
        <div class="flex flex-col gap-3">
          <h1
            class="type-h1 text-content-primary text-balance"
          >
            Learn
          </h1>
          <p
            class="type-body-md max-w-2xl text-content-secondary text-pretty"
          >
            Interactive playground and lessons from the best design engineering skills
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            playbookCards.map((entry) => (
              <PlaybookCard
                href={`/playbook/${entry.slug}`}
                title={entry.title}
                description={entry.description}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

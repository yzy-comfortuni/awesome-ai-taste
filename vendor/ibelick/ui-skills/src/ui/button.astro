---
type Props = {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "lg" | "md" | "sm";
  shape?: "square" | "rounded";
  className?: string;
  type?: "button" | "submit" | "reset";
} & Record<string, any>;

const {
  href,
  variant = "primary",
  size = "md",
  shape = "square",
  className = "",
  type = "button",
  ...rest
} = Astro.props as Props;

const baseClass =
  "type-body-md inline-flex select-none items-center justify-center font-normal transition-[background-color,color,border-color] duration-150 ease-out focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-content-primary";

const sizeClass =
  size === "lg"
    ? "h-10 gap-2 px-5"
    : size === "sm"
      ? "h-7 gap-1 px-2"
      : "h-8 gap-1.5 px-3";

const shapeClass = shape === "rounded" ? "rounded-full" : size === "lg" ? "rounded-xl" : "rounded-lg";

const variantClass =
  variant === "secondary"
    ? "border border-line-default bg-fill-default text-content-primary hover:bg-fill-subtle"
    : variant === "ghost"
      ? "border border-transparent bg-transparent text-content-secondary hover:bg-fill-strong hover:text-content-primary"
      : "border border-transparent bg-fill-inverse text-content-inverse";

const buttonClass = `${baseClass} ${sizeClass} ${shapeClass} ${variantClass} ${className}`;
---

{
  href ? (
    <a
      href={href}
      class={buttonClass}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={buttonClass}
      {...rest}
    >
      <slot />
    </button>
  )
}

---
import Button from "./button.astro";
import type { ComponentCollection } from "../data/component-libraries";

type CollectionOption = {
  slug: ComponentCollection;
  routeSlug: string;
  controlTitle: string;
  count: number;
};

type Props = {
  collections: CollectionOption[];
};

const { collections } = Astro.props as Props;
---

<nav aria-label="Component collections" class="flex flex-wrap gap-2">
  {
    collections.map((collection) => (
      <Button
        href={`/components/${collection.routeSlug}`}
        variant="secondary"
        size="sm"
      >
        {collection.controlTitle}
        <span class="type-body-sm text-content-muted tabular-nums">
          {collection.count}
        </span>
      </Button>
    ))
  }
</nav>

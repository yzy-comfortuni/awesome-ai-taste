---
import { ChevronRightIcon } from "@heroicons/react/24/outline";
import type { PublicJob } from "../lib/jobs-api";

type Props = {
  jobs: PublicJob[];
};

const { jobs } = Astro.props as Props;

function formatDate(value: string) {
  const date = new Date(value);
  if (Number.isNaN(date.valueOf())) return "Recently posted";
  return `Posted ${new Intl.DateTimeFormat("en", { month: "short", day: "numeric" }).format(date)}`;
}

function logoUrl(companyWebsite: string | null) {
  if (!companyWebsite) return null;
  try {
    return `https://www.google.com/s2/favicons?domain=${new URL(companyWebsite).hostname}&sz=128`;
  } catch {
    return null;
  }
}
---

{jobs.length > 0 ? (
  <section class="flex flex-col gap-5">
    <a
      href="/jobs"
      class="section-title type-body-md inline-flex items-center gap-0.5 self-start font-[450] text-content-secondary"
    >
      <span>Jobs</span>
      <ChevronRightIcon className="size-4 text-content-muted" aria-hidden="true" />
    </a>
    <div class="flex flex-col">
      {jobs.map((job) => {
        const logo = logoUrl(job.companyWebsite);

        return (
          <a
            href={`/jobs/${job.id}`}
            class="group border-line-default flex items-center gap-3 border-b pt-3 pb-4 first:pt-0"
          >
            {logo ? (
              <img
                src={logo}
                alt={`${job.companyName} logo`}
                width="40"
                height="40"
                loading="lazy"
                class="border-line-default size-10 shrink-0 rounded-xl border object-contain"
              />
            ) : (
              <div
                aria-hidden="true"
                class="bg-fill-subtle border-line-default size-10 shrink-0 rounded-xl border"
              />
            )}
            <div class="min-w-0 flex-1">
              <div class="type-body-md text-content-primary truncate font-[450]">
                {job.title}
              </div>
              <div class="type-body-md text-content-secondary truncate">
                {job.companyName} · {job.location} · {job.employmentType} · {formatDate(job.publishedAt)}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
) : null}

---
type Props = {
  href: string;
  title: string;
  description: string;
  ariaLabel?: string;
};

import Card from "./card.astro";

const {
  href,
  title,
  description,
  ariaLabel,
} = Astro.props as Props;
---

<a href={href} aria-label={ariaLabel ?? title} class="group block h-full">
  <Card className="h-full transition-colors group-hover:border-content-extra-muted">
    <div class="flex flex-col gap-0.5">
      <div class="type-body-md font-[450] text-content-primary">{title}</div>
      <div class="type-body-md line-clamp-3 text-content-secondary">
        {description}
      </div>
    </div>
  </Card>
</a>
